# ==============================================================================
# E-COMMERCE ANALYTICS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your specific project settings.
# IMPORTANT: Never commit the actual '.env' file or service account keys to Git!

# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) & BigQuery Configuration
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=US
BIGQUERY_DATASET_RAW=ecommerce_raw
BIGQUERY_DATASET_ANALYTICS=ecommerce_analytics
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp_service_account.json

# ------------------------------------------------------------------------------
# dbt Configuration
# ------------------------------------------------------------------------------
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev
DBT_THREADS=4

# ------------------------------------------------------------------------------
# Storage & Local Pipeline Configuration
# ------------------------------------------------------------------------------
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
LOG_LEVEL=INFO
LOCAL_DEV_DB_PATH=./data/processed/ecommerce_analytics.duckdb

# ------------------------------------------------------------------------------
# Apache Airflow Configuration
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
